# Copy to android/keystore.properties (git-ignored) to sign release builds.
# Скопируйте в android/keystore.properties (не коммитится), чтобы подписывать релизные сборки.
# Create a key / создать ключ:
#   keytool -genkeypair -v -keystore keepshop-release.jks -alias keepshop -keyalg RSA -keysize 4096 -validity 10000
storeFile=/absolute/path/to/keepshop-release.jks
storePassword=CHANGE_ME
keyAlias=keepshop
keyPassword=CHANGE_ME
