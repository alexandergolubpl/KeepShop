{
  "name": "keepshop",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@fontsource/inter": "^5.3.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "bwip-js": "^4.11.4",
    "firebase": "^11.6.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single && node -e \"require('fs').renameSync('dist-single/index.html','dist-single/keepshop_ai.html')\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && npx cap sync android",
    "icons": "npx capacitor-assets generate --android --iconBackgroundColor \"#f59e0b\" --iconBackgroundColorDark \"#f59e0b\" --splashBackgroundColor \"#ffffff\" --splashBackgroundColorDark \"#18181b\""
  },
  "type": "module"
}
